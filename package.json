    "format:backend": "cd src-tauri && cargo fmt"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "prettier": "^3.10.1"
  },
  "description": "Free, open source junk cleaner and system booster for Windows (Tauri 2)",
  "license": "MIT",
  "author": "Muhammad Ahmad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itxahmaddev/juncle.git"
  },
  "homepage": "https://github.com/itxahmaddev/juncle"
}
